rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isParticipant(sessionData) {
      return isSignedIn()
        && sessionData.participants is list
        && request.auth.uid in sessionData.participants;
    }

    function isSessionOwner(sessionData) {
      return isSignedIn() && request.auth.uid == sessionData.ownerId;
    }

    function roleOf(sessionData, uid) {
      return sessionData.participantRoles[uid];
    }

    function isOwnerRole(sessionData) {
      return isSessionOwner(sessionData) || roleOf(sessionData, request.auth.uid) == "OWNER";
    }

    function isEditor(sessionData) {
      return roleOf(sessionData, request.auth.uid) == "EDITOR";
    }

    function participantListValid(data) {
      return data.participants is list
        && data.participants.size() >= 1
        && data.participants.size() <= 20;
    }

    function baseSessionShapeValid(data) {
      return data.ownerId is string
        && data.title is string
        && participantListValid(data)
        && data.participantRoles is map
        && data.participants.hasAny([data.ownerId])
        && data.participantRoles[data.ownerId] == "OWNER";
    }

    function canCreateSession() {
      return isSignedIn()
        && baseSessionShapeValid(request.resource.data)
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participantRoles[request.auth.uid] == "OWNER";
    }

    // Join-Self: Ein eingeloggter Nutzer darf nur sich selbst als VIEWER/EDITOR hinzufügen.
    // Er darf ownerId, Titel, Invite-Daten und Policies nicht verändern.
    function canJoinSelf() {
      return isSignedIn()
        && !(request.auth.uid in resource.data.participants)
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == resource.data.participants.size() + 1
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.title == resource.data.title
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["participants", "participantRoles", "updatedAt"])
        && request.resource.data.participantRoles.diff(resource.data.participantRoles)
          .affectedKeys().hasOnly([request.auth.uid])
        && (
          request.resource.data.participantRoles[request.auth.uid] == "VIEWER"
          || request.resource.data.participantRoles[request.auth.uid] == "EDITOR"
        )
        && participantListValid(request.resource.data);
    }

    // Leave-Self: Ein Teilnehmer darf nur sich selbst aus Teilnehmerliste/Rollen entfernen.
    function canLeaveSelf() {
      return isSignedIn()
        && request.auth.uid in resource.data.participants
        && !(request.auth.uid in request.resource.data.participants)
        && request.resource.data.participants.size() == resource.data.participants.size() - 1
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.title == resource.data.title
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["participants", "participantRoles", "updatedAt"])
        && !request.resource.data.participantRoles.keys().hasAny([request.auth.uid])
        && participantListValid(request.resource.data);
    }

    function canManageSession() {
      return isSignedIn()
        && isOwnerRole(resource.data)
        && baseSessionShapeValid(request.resource.data)
        && participantListValid(request.resource.data);
    }

    function canWriteMessages(sessionData) {
      return isParticipant(sessionData)
        && (
          isOwnerRole(sessionData)
          || (isEditor(sessionData) && sessionData.editorCanSendMessages != false)
        );
    }

    function canWriteAiMessages(sessionData) {
      return isParticipant(sessionData)
        && sessionData.aiEnabled != false
        && (
          isOwnerRole(sessionData)
          || (isEditor(sessionData) && sessionData.editorCanUseAi != false)
        );
    }

    function canWriteWorkspace(sessionData) {
      return isParticipant(sessionData)
        && (
          isOwnerRole(sessionData)
          || (isEditor(sessionData) && sessionData.editorCanEditWorkspace != false)
        );
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /persona_profiles/{personaName} {
        allow read, write: if isOwner(uid);
      }

      match /persona_prompts/{personaName} {
        allow read, write: if isOwner(uid);
      }

      match /persona_training_examples/{exampleId} {
        allow read, write: if isOwner(uid);
      }

      match /chat_conversations/{conversationId} {
        allow read, write: if isOwner(uid);

        match /messages/{messageId} {
          allow read, write: if isOwner(uid);
        }
      }

      match /chat_backups/{backupId} {
        allow read, write: if isOwner(uid);
      }
    }

    match /user_memory/{uid}/entries/{entryId} {
      allow read, write: if isOwner(uid);
    }

    match /user_knowledge/{uid}/chunks/{chunkId} {
      allow read, write: if isOwner(uid);
    }

    match /collab_sessions/{sessionId} {
      allow create: if canCreateSession();

      // Wichtig: Nicht mehr für alle eingeloggten Nutzer lesbar.
      // Teilnehmer können lesen. Join per Invite sollte idealerweise über eine Function erfolgen.
      allow read: if isParticipant(resource.data);

      allow update: if isSignedIn() && (
        canManageSession()
        || canJoinSelf()
        || canLeaveSelf()
      );

      allow delete: if isSessionOwner(resource.data);

      match /messages/{messageId} {
        function sessionData() {
          return get(/databases/$(database)/documents/collab_sessions/$(sessionId)).data;
        }

        allow read: if isParticipant(sessionData());

        allow create: if isSignedIn()
          && request.resource.data.authorId == request.auth.uid
          && isParticipant(sessionData())
          && (
            (
              request.resource.data.isAi == true
              && canWriteAiMessages(sessionData())
            )
            || (
              request.resource.data.isAi != true
              && canWriteMessages(sessionData())
            )
          );

        allow update, delete: if false;
      }

      match /presence/{uid} {
        function sessionData() {
          return get(/databases/$(database)/documents/collab_sessions/$(sessionId)).data;
        }

        allow read: if isParticipant(sessionData());

        allow create, update, delete: if isSignedIn()
          && request.auth.uid == uid
          && isParticipant(sessionData());
      }

      match /workspace/{docId} {
        function sessionData() {
          return get(/databases/$(database)/documents/collab_sessions/$(sessionId)).data;
        }

        allow read: if isParticipant(sessionData());

        allow create, update: if isParticipant(sessionData())
          && canWriteWorkspace(sessionData());

        allow delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
